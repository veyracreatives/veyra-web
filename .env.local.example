# ═══════════════════════════════════════════════════════════════════════════
#  Veyra — environment
#
#  Copy this file to `.env.local` and fill in the values. `.env*` is
#  gitignored, so your keys never get committed.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Supabase (content) ───────────────────────────────────────────────────
# Supabase → Project Settings → API Keys
#   URL  is the "Project URL" (https://xxxx.supabase.co)
#   key is the "Secret key"  (sb_secret_...)
#
# Supabase stores the editable content document (text, card fields, the URLs
# of uploaded images). Use the SECRET key, not the anon/publishable one: this
# table has row-level security enabled with no policies, so only a key that
# bypasses RLS can read or write it. The legacy "service_role" key (a long
# eyJ... JWT) also works and is still accepted, but it is deprecated at the
# end of 2026.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── Cloudinary (image uploads) ───────────────────────────────────────────
# Cloudinary → Dashboard → Product Environment Credentials.
#
# Logos and work-card images are uploaded here. The API secret signs the
# upload, so it must stay on the server — never prefix it with NEXT_PUBLIC_.
# Uploads go through /api/admin/upload, which keeps the secret hidden.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret

# Optional. Folder every upload is filed under. Defaults to "veyra".
# CLOUDINARY_FOLDER=veyra

# ─── Admin panel (/admin_veyra) ───────────────────────────────────────────
# Optional. These are the built-in defaults, so the panel works without them.
# ADMIN_USER=Dibesh
# ADMIN_PASSWORD=mady1007mady

# Optional. Signs the session cookie. If unset it falls back to a value
# derived from the user + password, which is fine for one site but means
# changing either one signs everyone out.
# ADMIN_SESSION_SECRET=some-long-random-string