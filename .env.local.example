# ═══════════════════════════════════════════════════════════════════════════
#  Veyra — environment
#
#  Copy this file to `.env.local` and fill in the values. `.env*` is
#  gitignored, so your keys never get committed.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Supabase ─────────────────────────────────────────────────────────────
# Supabase → Project Settings → API Keys
#   URL  is the "Project URL" (https://xxxx.supabase.co)
#   key is the "Secret key"  (sb_secret_...)
#
# Use the SECRET key, not the anon/publishable one. This table has row-level
# security enabled with no policies, so only a key that bypasses RLS can read
# or write it. The legacy "service_role" key (a long eyJ... JWT) also works
# and is still accepted, but it is deprecated at the end of 2026.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional. Defaults to "uploads" — must match the bucket created by
# supabase/schema.sql.
# SUPABASE_UPLOAD_BUCKET=uploads

# ─── Admin panel (/admin_veyra) ───────────────────────────────────────────
# Optional. These are the built-in defaults, so the panel works without them.
# ADMIN_USER=Dibesh
# ADMIN_PASSWORD=mady1007mady

# Optional. Signs the session cookie. If unset it falls back to a value
# derived from the user + password, which is fine for one site but means
# changing either one signs everyone out.
# ADMIN_SESSION_SECRET=some-long-random-string